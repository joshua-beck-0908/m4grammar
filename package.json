{
  "name": "m4-syntax",
  "displayName": "GNU M4 Syntax Highlighting",
  "description": "Syntax highlighting and a lightweight language server for the GNU m4 macro processor (.m4 files, .md.m4 Markdown+M4 files, and m4 code cells in Jupyter notebooks). Tracks changequote/changecom/changeword and macro definitions live, on top of a TextMate grammar.",
  "version": "0.3.1",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "m4",
    "gnu m4",
    "macro",
    "autoconf",
    "preprocessor",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joshua-beck-0908/m4grammar"
  },
  "main": "./out/client/extension.js",
  "activationEvents": [
    "onLanguage:m4",
    "onLanguage:m4-markdown"
  ],
  "contributes": {
    "languages": [
      {
        "id": "m4",
        "aliases": ["M4", "GNU M4", "m4"],
        "extensions": [".m4", ".m4i", ".m4f"],
        "filenames": ["aclocal.m4"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "m4-markdown",
        "aliases": ["Markdown+M4", "M4 Markdown"],
        "extensions": [".md.m4"],
        "configuration": "./language-configuration.md-m4.json"
      }
    ],
    "grammars": [
      {
        "language": "m4",
        "scopeName": "source.m4",
        "path": "./syntaxes/m4.tmLanguage.json"
      },
      {
        "language": "m4-markdown",
        "scopeName": "text.html.markdown.m4",
        "path": "./syntaxes/m4-markdown.tmLanguage.json"
      },
      {
        "scopeName": "m4.injection.markdown",
        "path": "./syntaxes/m4-markdown-injection.tmLanguage.json",
        "injectTo": ["text.html.markdown.m4"]
      }
    ],
    "snippets": [
      {
        "language": "m4-markdown",
        "path": "./snippets/m4-markdown.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "macroCall",
        "description": "A name(...) call whose target macro could not be resolved (not a builtin, and no reachable define/pushdef found)."
      },
      {
        "id": "plainOverride",
        "description": "A span the static grammar would still color under its hardcoded default quote/comment/keyword assumptions, even though the language server's live tracking has determined it isn't special any more (e.g. a bare # after changecom moves comments elsewhere). Mapped to the language's own root scope, which no theme rule matches, so it renders as ordinary text."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "m4",
        "scopes": {
          "macroCall": ["entity.name.function.unresolved.m4"],
          "plainOverride": ["source.m4"]
        }
      },
      {
        "language": "m4-markdown",
        "scopes": {
          "macroCall": ["entity.name.function.unresolved.m4"],
          "plainOverride": ["text.html.markdown.m4"]
        }
      }
    ],
    "configuration": {
      "title": "M4",
      "properties": {
        "m4.maxIncludeDepth": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 32,
          "description": "Maximum depth of include()/sinclude() files the language server will follow to resolve macro definitions."
        },
        "m4.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace communication between VS Code and the M4 language server (for debugging the extension itself)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p .",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.32.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  }
}
