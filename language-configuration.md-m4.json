{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "`", "close": "`" },
    { "open": "\"", "close": "\"" },
    { "open": "*", "close": "*", "notIn": ["string"] },
    { "open": "_", "close": "_", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["`", "`"],
    ["*", "*"],
    ["_", "_"]
  ],
  "wordPattern": "[A-Za-z_\\u0080-\\uFFFF][A-Za-z0-9_\\u0080-\\uFFFF]*"
}
