{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["⟦", "⟧"],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "⟦", "close": "⟧" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "`", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["⟦", "⟧"],
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["`", "'"]
  ],
  "wordPattern": "[A-Za-z_\\u0080-\\u27E5\\u27E8-\\uFFFF][A-Za-z0-9_\\u0080-\\u27E5\\u27E8-\\uFFFF]*"
}
